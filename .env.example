# Copy this file to .env and fill in real values.
# .env is git-ignored and should never be committed.

# --- User/permissions ---
# On Linux hosts, run `id $USER` to get these. On Windows/laptop testing, 1000:1000 is fine.
PUID=1000
PGID=1000
TZ=Asia/Jerusalem

# --- Paths ---
# Two roots, so app config and media can live on different drives.
# Use forward slashes, including for Windows drive letters (D:/...).
#
# CONFIG_ROOT: each app's settings/database (small, many writes -> fast drive).
#   Holds one subfolder per app: jellyfin/, sonarr/, radarr/, ...
CONFIG_ROOT=./data/appdata
#
# MEDIA_ROOT: the library and downloads (large -> big drive).
#   Must contain media/ (shows/, movies/) and torrents/ side by side.
#   Laptop: ./data    Desktop: D:/streameron
MEDIA_ROOT=./data

# --- VPN (Gluetun + CyberGhost) ---
# Get these from my.cyberghostvpn.com -> Products -> VPN -> Advanced Configuration
# -> Manual setup -> Configure Device. This generates a dedicated OpenVPN
# username/password, NOT your account login email/password.
OPENVPN_USER=
OPENVPN_PASSWORD=

# --- Recyclarr ---
# From each app's Settings -> General -> Security -> API Key.
SONARR_API_KEY=
RADARR_API_KEY=
